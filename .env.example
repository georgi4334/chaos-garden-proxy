PORT=3100
# Where the control API lives, and the shared key it expects (must match its INTERNAL_API_KEY).
CONTROL_API_URL=http://localhost:3000
INTERNAL_API_KEY=change-me
# Local development only: allow targets on localhost / private networks (blocked by default to prevent SSRF).
ALLOW_PRIVATE_TARGETS=true
# Optional tuning (defaults shown)
# CONFIG_CACHE_TTL_MS=5000
# UPSTREAM_TIMEOUT_MS=10000
# MAX_BODY_BYTES=1048576
